{
  "name": "papertrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:prune-rate-limits": "node scripts/prune-rate-limits.mjs",
    "build:vercel": "npm run db:migrate && npm run build",
    "test:integration": "node scripts/integration-test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:integration"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "framer-motion": "^13.2.0",
    "next": "^15.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.9.2"
  }
}
