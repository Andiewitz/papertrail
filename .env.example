# Create a database at https://turso.tech, then copy these values from its Connect panel.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-32-byte-random-secret

# Set this only when using a stable production/custom domain. No trailing slash.
# Vercel preview deployments work without it.
APP_URL=https://your-domain.example
